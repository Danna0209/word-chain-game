let usedWords = new Set();
let lastChar = null;

function validateAndAdd(word) {
    word = word.toLowerCase().trim();

    // 1. Basic sanity check (No gibberish allowed)
    // If the word is longer than 15 letters, it's likely a random mash
    if (word.length > 15 || word.length < 2) {
        return { valid: false, message: "Invalid word length!" };
    }

    // 2. Check if already used
    if (usedWords.has(word)) return { valid: false, message: "Already used!" };

    // 3. Check starting letter (The "Chain" rule)
    if (lastChar !== null && word.charAt(0) !== lastChar) {
        return { valid: false, message: "Must start with " + lastChar };
    }

    // 4. Update state
    usedWords.add(word);
    lastChar = word.charAt(word.length - 1);
    return { valid: true, nextChar: lastChar };
}
async function isValidWord(word) {
    try {
        const response = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${word}`);
        return response.ok; // Returns true if the word exists, false if not
    } catch (error) {
        return false;
    }
}
async function handleInput() {
    let inputField = document.getElementById("wordInput");
    let input = inputField.value.toLowerCase().trim();
    
    // Check if it's a real word first
    const isReal = await isValidWord(input);
    
    if (!isReal) {
        alert("Not a real word! Game Over.");
        // ... trigger your reset logic here
        return;
    }
    
    // Now perform your existing logic (last character match, etc.)
    let result = validateAndAdd(input);
    if (result.valid) {
        // ... increment score
    } else {
        // ... game over
    }
}
const dictionary = ["the", "be", "to", "of", "and", "a", "in", "that", /* ... paste many words here ... */];

function validateAndAdd(word) {
    if (!dictionary.includes(word)) {
        return { valid: false, message: "Not a word!" };
    }
    // ... rest of your logic
}
function handleKeyPress(event) {
    if (event.key === "Enter") {
        handleInput();
        // Find the button and trigger the click animation
        let btn = document.querySelector("button");
        btn.click(); // Runs your submit logic
        
        // Optional: Add a temporary 'pressed' class for extra feedback
        btn.classList.add("active");
        setTimeout(() => btn.classList.remove("active"), 150);
    }
}
let score = 0;

    function handleInput() {
        console.log("Submit button clicked!"); // This helps you see if it's working
        
        let inputField = document.getElementById("wordInput");
        let input = inputField.value;
        
        let result = validateAndAdd(input);
        let msgBox = document.getElementById("message");

        let scoreDisplay = document.getElementById("scoreDisplay");
        
        if (result.valid) {
            score++;
            msgBox.innerText = "Score: " + score + " | Next: " + result.nextChar;
            inputField.value = "";
            inputField.focus();
        } else {
            alert("Game Over! " + result.message + "Final Score: " + score);

            document.getElementById("homeScreen").style.display = "block";
            document.getElementById("gameScreen").style.display = "none";
            
            score = 0;
            usedWords.clear();
            lastChar = null; 
            msgBox.innerText = "Enter a word to start!";
        }

        // Force clear
        inputField.value = ""; 
        inputField.focus(); 
        
        console.log("Input box cleared.");
    }
    function startGame() {
    document.getElementById("homeScreen").style.display = "none";
    document.getElementById("gameScreen").style.display = "block";
    document.getElementById("wordInput").focus();
}
    function resetGame(){
        score = 0;
        usedWords.clear();
        lastChar = null;
        document.getElementById("message").innerText = "Game Over. Press Play to start again!";
    }